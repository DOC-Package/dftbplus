Geometry = GenFormat {
  <<< "butadiene.gen"
}

Driver = ConjugateGradient{MaxSteps=0}

Hamiltonian = DFTB {

  SCC = Yes
  SCCTolerance = 1e-8

  MaxAngularMomentum = {
    C = "p"
    H = "s"
  }

  SlaterKosterFiles = Type2FileNames {
    Prefix = "slakos/origin/hybrid/cam/HC/"
    Separator = "-"
    Suffix = ".skf"
  }

  Filling = Fermi {Temperature [K] = 0.0}

  Hybrid = CAM {
    Screening = MatrixBased {}
  }

}

ExcitedState {
  Casida {
    NrOfExcitations = 10
    StateOfInterest = 1
    Symmetry = Singlet
    WriteMulliken = Yes
    Diagonaliser = Stratmann {SubSpaceFactor = 50}
  }
}

Options {
  WriteAutotestTag = Yes
}

ParserOptions {
  ParserVersion = 10
}

Parallel {
  # Allow OMP threads explicitely to test for hybrid parallelisation with
  # MPI-binary. (Check the manual before using this in production runs!)
  UseOmpThreads = Yes
}